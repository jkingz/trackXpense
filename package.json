    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "inngest": "^4.24.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.2",
