{
  "name": "trackxpense-fresh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed-demo.ts",
    "db:migrate": "prisma migrate deploy",
    "email": "tsx scripts/render-email.ts",
    "prepare": "vp config --no-agent",
    "postinstall": "prisma generate",
    "test": "vp test",
    "test:integration": "vp test tests/integration",
    "test:e2e": "playwright test",
    "lint": "vp check",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@arcjet/next": "1.14.1",
