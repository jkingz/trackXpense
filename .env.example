# Names only, all values empty. Copy to .env.local and fill locally; never commit a real value.
# Every name below is read at the cited site. Today a local `pnpm dev` needs the database pair to serve
# any ledger page; the Clerk pair is still required because `proxy.ts` runs `clerkMiddleware` on every
# request, even though nothing redirects to sign-in any more; ARCJET_KEY is not in the request path at all.

# PostgreSQL — lib/prisma.ts:6 (pg driver adapter), prisma.config.ts:16
# Carry both SSL parameters: `sslmode=verify-full&uselibpqcompat=true`. Plain `sslmode=require` triggers
# a pg-connection-string deprecation warning, and adding uselibpqcompat=true to *that* value would silently
# turn off certificate verification (pg parses it to ssl: { rejectUnauthorized: false }).
DATABASE_URL=
# Prisma CLI / migrations. prisma.config.ts:16 falls back to DATABASE_URL when this is empty.
DIRECT_URL=

# Clerk — read by @clerk/nextjs from the environment; nothing in the tree names them.
# Still needed to boot: proxy.ts runs clerkMiddleware on every request. With the forced-login leg
# commented out, an anonymous visit to /dashboard renders the seeded ledger instead of redirecting.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Arcjet — lib/arcjet.ts:4 is the only live read; it is reached from the transaction write path
# (actions/transaction.ts:7 tokenBucket). The proxy.ts client is commented out (proxy.ts:25-32), so pages no
# longer 403 without this key — restore the key together with that leg if rate limiting on every request comes back.
ARCJET_KEY=

# Resend — actions/send-email.ts:6 (`|| ''`, so an absent key yields a client that cannot send).
RESEND_API_KEY=

# Gemini — actions/transaction.ts:12 and lib/inngest/functions.ts:217 (receipt OCR).
GEMINI_API_KEY=

# Dev seed only — actions/seed.ts:8-9, both behind `as string` assertions on possibly-absent vars.
# Not documented as required anywhere; the seed path is unverified because of them.
ACCOUNT_ID=
USER_ID=
