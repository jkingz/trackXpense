# Names only, all values empty. Copy to .env.local and fill locally; never commit a real value.

# Public origin — lib/site.ts. Builds metadataBase, canonical, Open Graph URLs,
# robots.txt, sitemap.xml and JSON-LD. Inlined at build time, not read per
# request, so the prerendered HTML carries the right URLs. Unset falls back to
# http://localhost:3000, which is right for `next dev` and wrong for a deploy.
NEXT_PUBLIC_APP_URL=

# PostgreSQL — lib/prisma.ts (pg driver adapter), prisma.config.ts (migrations)
# Use `sslmode=verify-full&uselibpqcompat=true`; plain `sslmode=require` is deprecated by pg.
DATABASE_URL=
# Prisma CLI. prisma.config.ts falls back to DATABASE_URL when empty.

# Better Auth — lib/neon-auth.ts. Session signing secret; required outside local dev.
BETTER_AUTH_SECRET=
# Better Auth — lib/neon-auth.ts `baseURL`. Must be the public origin in production.
BETTER_AUTH_URL=

# Demo account password — lib/demo.ts. Defaults to "demo123" when empty.
DEMO_USER_PASSWORD=

# Arcjet — lib/arcjet.ts, used by createTransaction (actions/transaction.ts).
ARCJET_KEY=

# Resend — actions/send-email.ts.
RESEND_API_KEY=

# Gemini — receipt OCR, actions/transaction.ts.
GEMINI_API_KEY=
