# Names only, all values empty. Copy to .env.local and fill locally; never commit a real value.
# Every name below is read at the cited site. A local `pnpm dev` needs the two Clerk keys and
# ARCJET_KEY just to serve a page; the money path additionally needs the database pair.

# PostgreSQL — lib/prisma.ts:6 (pg driver adapter), prisma.config.ts:16
DATABASE_URL=
# Prisma CLI / migrations. prisma.config.ts:16 falls back to DATABASE_URL when this is empty.
DIRECT_URL=

# Clerk — read by @clerk/nextjs from the environment; nothing in the tree names them.
# Without these, proxy.ts cannot mint a session and the app 302s to /sign-in.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Arcjet — lib/arcjet.ts:4 and proxy.ts:14 (each builds its own client).
# proxy.ts is the root request hook, so without this key `pnpm dev` answers 403 on every page.
ARCJET_KEY=

# Resend — actions/send-email.ts:6 (`|| ''`, so an absent key yields a client that cannot send).
RESEND_API_KEY=

# Gemini — actions/transaction.ts:12 and lib/inngest/functions.ts:217 (receipt OCR).
GEMINI_API_KEY=

# Dev seed only — actions/seed.ts:8-9, both behind `as string` assertions on possibly-absent vars.
# Not documented as required anywhere; the seed path is unverified because of them.
ACCOUNT_ID=
USER_ID=
