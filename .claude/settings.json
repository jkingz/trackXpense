{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current *)",
      "Bash(git rev-parse *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(pnpm *)",
      "Bash(vp *)",
      "Read(./.env.example)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(rm *-rf*)",
      "Bash(*--no-verify*)",
      "Bash(*--skip-hooks*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.next/**)",
      "Edit(./node_modules/**)"
    ],
    "ask": ["Bash(git commit *)", "Bash(git push *)", "Bash(prisma migrate *)"]
  }
}
